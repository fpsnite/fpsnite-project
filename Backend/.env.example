# Copy to .env for local development (never commit .env).
# All values are optional; defaults are shown.

# Postgres (Supabase) is the production database. Paste your Supabase
# connection string here - use the *direct* connection (port 5432), not the
# transaction pooler (port 6543), since the app uses SQLAlchemy sessions.
# Local dev fallback: sqlite:///./fpsnite.db (no Postgres needed).
DATABASE_URL=sqlite:///./fpsnite.db

# Comma-separated origins allowed by CORS (Godot desktop clients ignore CORS).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Leave empty to run without the Discord bot.
DISCORD_BOT_TOKEN=

# Set to "true" to run the Discord bot inside the API process (long-lived
# hosts only - NOT on Vercel). On Vercel run the bot separately with `python -m bot`.
RUN_BOT=false

ENV=development